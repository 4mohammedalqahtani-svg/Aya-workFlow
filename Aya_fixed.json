    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "let minLength = 60; // تقدر تعدل هذا الرقم لتحديد أقصر طول للآية\nlet ayahText = \"\";\nlet fullResult = {};\n\n// حلقة تكرار تبحث حتى تجد آية أطول من الحد الأدنى\nwhile (ayahText.length < minLength) {\n    let randomNum = Math.floor(Math.random() * 6236) + 1;\n    \n    // إعدادات الطلب باستخدام طريقة n8n المعتمدة\n    let options = {\n        method: 'GET',\n        url: `http://api.alquran.cloud/v1/ayah/${randomNum}/quran-uthmani`,\n        json: true // يحول النتيجة تلقائياً إلى JSON\n    };\n    \n    // جلب البيانات من الـ API\n    fullResult = await this.helpers.httpRequest(options);\n    ayahText = fullResult.data.text;\n}\n\n// نرجع آية واحدة فقط، بتستخدم لاحقاً لكل المشتركين\nreturn [{ json: fullResult }];"
      },
